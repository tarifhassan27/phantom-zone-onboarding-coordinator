    {
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "const hire_id = $('Check for blockers').item.json.id;\nconst full_name = $('Check for blockers').item.json.full_name;\nconst hire_type = $('Check for blockers').item.json.hire_type;\nconst start_date = $('Check for blockers').item.json.start_date;\n\nconst offset = $input.item.json.due_offset;\nconst task_name = $input.item.json.task_name;\nconst owner = $input.item.json.owner;\n\nconst due = new Date(start_date);\ndue.setDate(due.getDate() + offset);\n\nreturn {\n  hire_id: hire_id,\n  full_name: full_name,\n  hire_type: hire_type,\n  task_name: task_name,\n  owner: owner,\n  due_date: due.toISOString().split('T')[0]\n};"
      },
